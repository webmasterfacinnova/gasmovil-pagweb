---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import DualFeatureSection from "@/components/DualFeatureSection.astro";
import { Flame, Truck, Shield, Clock, MapPin, ChevronRight, Play, Star, Zap, Users, Award } from "lucide-react";

const title = "Gasmovil - Gas LP a domicilio en minutos";
const description = "Pide gas LP desde tu celular. Rastreo en vivo, múltiples direcciones y pago seguro. La forma más inteligente de pedir gas.";
---

<Layout title={title} description={description}>
  <div class="relative min-h-screen hero-gradient noise-overlay">
    <Navbar />
    
    <!-- Hero Section -->
    <section class="relative px-4 pt-32 pb-20 sm:px-6 lg:px-8 lg:pt-40 lg:pb-32">
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
          <!-- Hero Content -->
          <div class="reveal">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 backdrop-blur-sm">
              <span class="flex h-2 w-2 rounded-full bg-green-400 animate-pulse"></span>
              <span class="text-xs font-medium text-slate-300">Disponible en tu zona</span>
            </div>
            
            <h1 class="mt-6 text-5xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl">
              Gas LP en
              <span class="gradient-text-fire"> minutos</span>,
              <br />no en horas
            </h1>
            
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
              Pide gas desde tu celular, rastrea tu entrega en tiempo real y paga de forma segura. 
              La revolución del gas a domicilio ha llegado.
            </p>
            
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="#download" class="btn-primary group">
                <span>Descargar la app</span>
                <ChevronRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </a>
              <button class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-6 py-4 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10">
                  <Play className="h-4 w-4 fill-white" />
                </div>
                <span>Ver cómo funciona</span>
              </button>
            </div>
            
            <!-- Stats -->
            <div class="mt-12 grid grid-cols-3 gap-6 border-t border-white/10 pt-8">
              <div>
                <div class="text-2xl font-bold text-white">50k+</div>
                <div class="text-sm text-slate-500">Usuarios activos</div>
              </div>
              <div>
                <div class="text-2xl font-bold text-white">4.9</div>
                <div class="flex items-center gap-1 text-sm text-slate-500">
                  <Star className="h-3 w-3 fill-amber-400 text-amber-400" />
                  <span>En app stores</span>
                </div>
              </div>
              <div>
                <div class="text-2xl font-bold text-white">15min</div>
                <div class="text-sm text-slate-500">Tiempo promedio</div>
              </div>
            </div>
          </div>
          
          <!-- Hero Visual -->
          <div class="relative reveal reveal-delay-2">
            <div class="relative">
              <!-- Background glow -->
              <div class="absolute -inset-4 rounded-full bg-gradient-to-r from-red-500/20 to-amber-500/20 blur-3xl"></div>
              
              <!-- Phone mockup -->
              <div class="relative mx-auto max-w-sm">
                <div class="glass-panel-strong rounded-[2.5rem] p-2">
                  <div class="relative overflow-hidden rounded-[2rem]" style="background: linear-gradient(to bottom, var(--surface-2), var(--surface-1));">
                    <img
                      src="/assets/img/order-detail-in-progress.png"
                      alt="App Gasmovil"
                      class="w-full"
                    />
                    <!-- Floating elements -->
                    <div class="absolute top-4 right-4 rounded-full bg-green-500/90 px-3 py-1 text-xs font-bold text-white backdrop-blur-sm">
                      En camino
                    </div>
                  </div>
                </div>
                
                <!-- Floating cards -->
                <div class="absolute -left-8 top-1/4 glass-panel rounded-2xl p-4 animate-float">
                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-500/20">
                      <MapPin className="h-5 w-5 text-green-400" />
                    </div>
                    <div>
                      <div class="text-xs text-slate-400">Distancia</div>
                      <div class="font-bold text-white">2.4 km</div>
                    </div>
                  </div>
                </div>
                
                <div class="absolute -right-4 bottom-1/4 glass-panel rounded-2xl p-4 animate-float-delayed">
                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-500/20">
                      <Clock className="h-5 w-5 text-amber-400" />
                    </div>
                    <div>
                      <div class="text-xs text-slate-400">Llegada</div>
                      <div class="font-bold text-white">8 min</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- App Showcase Section -->
    <section id="app" class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center reveal">
          <p class="section-kicker-accent">Interfaz intuitiva</p>
          <h2 class="section-title mx-auto max-w-3xl">
            Diseñada para que pidas en segundos, no en minutos
          </h2>
        </div>
        
        <!-- App Screenshots Slider -->
        <div class="mt-16 reveal reveal-delay-2">
          <div class="relative">
            <!-- Gradient overlays -->
            <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--surface-0)] to-transparent z-10"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--surface-0)] to-transparent z-10"></div>
            
            <!-- Screenshots container -->
            <div class="flex gap-6 overflow-x-auto pb-8 pt-4 px-4 snap-x snap-mandatory scrollbar-hide" style="-webkit-overflow-scrolling: touch;">
              {[
                { src: '/assets/img/order-detail-in-progress.png', alt: 'Detalle de pedido' },
                { src: '/assets/img/map-portrait.png', alt: 'Mapa de rastreo' },
                { src: '/assets/img/ETA-portrait.png', alt: 'Tiempo estimado' },
                { src: '/assets/img/driver-portrait.png', alt: 'Conductor' },
                { src: '/assets/img/cylinder-portrait.png', alt: 'Cilindro' },
              ].map((img) => (
                <div class="flex-shrink-0 snap-center">
                  <div class="glass-panel-strong rounded-[2rem] p-3 card-hover">
                    <div class="overflow-hidden rounded-[1.5rem]" style="background-color: var(--surface-2);">
                      <img
                        src={img.src}
                        alt={img.alt}
                        class="h-[500px] w-auto object-cover"
                      />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Gasmovil Section -->
    <section id="why" class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="grid gap-16 lg:grid-cols-2 items-center">
          <!-- Content -->
          <div class="reveal">
            <p class="section-kicker">¿Por qué Gasmovil?</p>
            <h2 class="section-title-alt">
              La forma más inteligente de pedir gas LP
            </h2>
            <p class="section-copy">
              Hemos reimaginado completamente la experiencia de pedir gas. Sin llamadas, sin esperas innecesarias, 
              sin incertidumbre. Solo abre la app, confirma tu pedido y rastrea tu entrega en tiempo real.
            </p>
            
            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              <div class="group rounded-2xl border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-white/10 hover:bg-white/[0.04]">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-red-500/20 to-red-600/10 text-red-400">
                  <Zap className="h-6 w-6" />
                </div>
                <h3 class="mt-4 font-bold text-white">Pedido express</h3>
                <p class="mt-2 text-sm text-slate-400">Confirma tu pedido en menos de 30 segundos con direcciones guardadas.</p>
              </div>
              
              <div class="group rounded-2xl border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-white/10 hover:bg-white/[0.04]">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-600/10 text-amber-400">
                  <Shield className="h-6 w-6" />
                </div>
                <h3 class="mt-4 font-bold text-white">Pago seguro</h3>
                <p class="mt-2 text-sm text-slate-400">Múltiples métodos de pago encriptados y protegidos.</p>
              </div>
              
              <div class="group rounded-2xl border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-white/10 hover:bg-white/[0.04]">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/10 text-blue-400">
                  <Users className="h-6 w-6" />
                </div>
                <h3 class="mt-4 font-bold text-white">Múltiples perfiles</h3>
                <p class="mt-2 text-sm text-slate-400">Gestiona pedidos para casa, trabajo o familiares desde una cuenta.</p>
              </div>
              
              <div class="group rounded-2xl border border-white/5 bg-white/[0.02] p-6 transition-all hover:border-white/10 hover:bg-white/[0.04]">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-purple-500/20 to-purple-600/10 text-purple-400">
                  <Award className="h-6 w-6" />
                </div>
                <h3 class="mt-4 font-bold text-white">Proveedores verificados</h3>
                <p class="mt-2 text-sm text-slate-400">Todos nuestros distribuidores pasan por verificación de calidad.</p>
              </div>
            </div>
          </div>
          
          <!-- Visual -->
          <div class="relative reveal reveal-delay-2">
            <div class="relative mx-auto max-w-md">
              <div class="absolute -inset-8 rounded-full bg-gradient-to-r from-amber-500/10 to-red-500/10 blur-3xl"></div>
              <div class="glass-panel-strong rounded-[2.5rem] p-3 relative">
                <img
                  src="/assets/img/map-portrait.png"
                  alt="App Gasmovil - Rastreo"
                  class="rounded-[2rem]"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <DualFeatureSection />

    <!-- CTA Section -->
    <section id="download" class="relative px-4 py-32 sm:px-6 lg:px-8">
      <div class="relative z-10 mx-auto max-w-5xl">
        <div class="relative overflow-hidden rounded-[2.5rem] border border-white/10 p-12 text-center lg:p-16 reveal glass-panel-strong">
          <!-- Background decoration -->
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-red-500/10 via-transparent to-transparent"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-amber-500/10 via-transparent to-transparent"></div>
          
          <div class="relative">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-gradient-to-br from-red-500 to-red-600 shadow-2xl shadow-red-500/25">
              <Flame className="h-10 w-10 text-white" />
            </div>
            
            <h2 class="mt-8 text-4xl font-bold text-white sm:text-5xl">
              ¿Listo para transformar<br />tu experiencia con el gas?
            </h2>
            
            <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
              Únete a miles de usuarios que ya disfrutan de entregas rápidas, 
              rastreo en vivo y la tranquilidad de saber exactamente cuándo llega su pedido.
            </p>
            
            <div class="mt-10 flex flex-wrap justify-center gap-4">
              <a href="#" class="btn-primary">
                <span>Descargar para iOS</span>
              </a>
              <a href="#" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/5 px-8 py-4 text-sm font-bold text-white backdrop-blur-sm transition-all hover:bg-white/10">
                <span>Descargar para Android</span>
              </a>
            </div>
            
            <p class="mt-8 text-sm text-slate-500">
              Disponible en iOS 14+ y Android 8+. Sin costo de descarga.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-2">
          <div class="reveal">
            <p class="section-kicker">Contacto</p>
            <h2 class="section-title-alt">¿Tienes preguntas?</h2>
            <p class="section-copy">
              Estamos aquí para ayudarte. Ya sea que tengas dudas sobre el servicio, 
              necesites soporte técnico o quieras convertirte en distribuidor, nuestro equipo está listo para atenderte.
            </p>
            
            <div class="mt-10 space-y-6">
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5">
                  <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white">Email</h3>
                  <p class="text-slate-400">hola@gasmovil.app</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5">
                  <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white">Teléfono</h3>
                  <p class="text-slate-400">+52 (55) 1234-5678</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5">
                  <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white">Ubicación</h3>
                  <p class="text-slate-400">Ciudad de México, México</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Contact Form -->
          <div class="reveal reveal-delay-2">
            <div class="glass-panel-strong rounded-3xl p-8">
              <form class="space-y-6">
                <div class="grid gap-6 sm:grid-cols-2">
                  <div>
                    <label class="block text-sm font-medium text-slate-300">Nombre</label>
                    <input 
                      type="text" 
                      class="mt-2 block w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-slate-500 focus:border-red-500/50 focus:outline-none focus:ring-1 focus:ring-red-500/50"
                      placeholder="Tu nombre"
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-slate-300">Email</label>
                    <input 
                      type="email" 
                      class="mt-2 block w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-slate-500 focus:border-red-500/50 focus:outline-none focus:ring-1 focus:ring-red-500/50"
                      placeholder="tu@email.com"
                    />
                  </div>
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-slate-300">Asunto</label>
                  <select class="mt-2 block w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white focus:border-red-500/50 focus:outline-none focus:ring-1 focus:ring-red-500/50">
                    <option value="" style="background-color: var(--surface-2);">Selecciona una opción</option>
                    <option value="support" style="background-color: var(--surface-2);">Soporte técnico</option>
                    <option value="sales" style="background-color: var(--surface-2);">Ventas</option>
                    <option value="distributor" style="background-color: var(--surface-2);">Quiero ser distribuidor</option>
                    <option value="other" style="background-color: var(--surface-2);">Otro</option>
                  </select>
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-slate-300">Mensaje</label>
                  <textarea 
                    rows="4" 
                    class="mt-2 block w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-slate-500 focus:border-red-500/50 focus:outline-none focus:ring-1 focus:ring-red-500/50"
                    placeholder="¿Cómo podemos ayudarte?"
                  ></textarea>
                </div>
                
                <button type="submit" class="btn-primary w-full">
                  Enviar mensaje
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Float animations */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  @keyframes float-delayed {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
  
  .animate-float-delayed {
    animation: float-delayed 4s ease-in-out infinite;
    animation-delay: 2s;
  }
</style>

<script>
  // Scroll reveal animation
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>