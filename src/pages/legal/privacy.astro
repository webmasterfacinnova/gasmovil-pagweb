---
import MainLayout from '../../layouts/MainLayout.astro';
import AdBanner from '../../components/AdBanner.astro';

const adSlotIDTop = '3473220690';

const policy = {
	lastUpdated: '16 de marzo de 2026',
	companyName: 'Facinnovation',
	applicationName: 'Gasmovil',
	companyAddress: 'Av. San Blas, 2468. Tlaquepaque, Jalisco, Mexico. CP 45615.',
	country: 'Mexico',
	contactEmail: 'soporte@facinnova.com',
	minorAge: 16,
	retentionMonths: 24,
};

const personalDataItems = [
	'Direccion de correo electronico',
	'Nombre y apellidos',
	'Numero de telefono',
	'Direccion, estado, provincia, codigo postal y ciudad',
	'Datos de uso',
];

const usageDataItems = [
	'Direccion IP del dispositivo (por ejemplo, direccion IP)',
	'Tipo y version del navegador',
	'Paginas del Servicio visitadas',
	'Fecha, hora y duracion de la visita',
	'Identificadores unicos del dispositivo y otros datos de diagnostico',
	'Tipo de dispositivo movil, sistema operativo movil y navegador movil',
];

const appDataItems = [
	'Informacion sobre tu ubicacion',
	'Imagenes y otra informacion de la camara y la biblioteca de fotos del dispositivo',
];

const personalDataUses = [
	'Proveer y mantener el Servicio, incluido el monitoreo de uso.',
	'Administrar tu Cuenta y habilitar funcionalidades para usuarios registrados.',
	'Cumplir contratos relacionados con productos o servicios adquiridos.',
	'Contactarte por correo, telefono, SMS o notificaciones push sobre actualizaciones, funcionalidades o seguridad.',
	'Enviarte noticias, ofertas especiales e informacion de bienes, servicios y eventos similares, salvo que te opongas.',
	'Atender y gestionar tus solicitudes.',
	'Evaluar o ejecutar transferencias empresariales (fusion, venta de activos, reorganizacion, liquidacion, etc.).',
	'Realizar analitica, identificar tendencias de uso y mejorar Servicio, productos, marketing y experiencia.',
];

const personalDataSharing = [
	'Con Proveedores de Servicios: para monitorear, analizar y contactarte.',
	'En transferencias de negocio: durante negociaciones o ejecucion de fusion, venta, financiamiento o adquisicion.',
	'Con Afiliadas: exigiendo que respeten esta Politica de Privacidad.',
	'Con socios comerciales: para ofrecerte productos, servicios o promociones.',
	'Con otros usuarios: cuando compartes datos en areas publicas del Servicio.',
	'Con tu consentimiento: para cualquier otro fin autorizado por ti.',
];

const retentionItems = [
	`Cuentas de usuario: durante la relacion de cuenta y hasta ${policy.retentionMonths} meses despues del cierre para atender incidencias posteriores o disputas.`,
	`Tickets y correspondencia de soporte: hasta ${policy.retentionMonths} meses desde el cierre del ticket para seguimiento, calidad y defensa legal.`,
	`Transcripciones de chat: hasta ${policy.retentionMonths} meses para aseguramiento de calidad y capacitacion del personal.`,
	`Estadisticas de uso de la aplicacion: hasta ${policy.retentionMonths} meses para medir adopcion y mejoras del servicio.`,
	`Registros de servidor (IP, tiempos de acceso): hasta ${policy.retentionMonths} meses para seguridad y resolucion de incidencias.`,
];

const retentionExtensionReasons = [
	'Obligacion legal: cuando una ley exige conservar datos especificos (por ejemplo, registros fiscales).',
	'Reclamaciones legales: cuando los datos son necesarios para ejercer o defender derechos.',
	'Solicitud expresa tuya: cuando pides conservar informacion especifica.',
	'Limitaciones tecnicas: cuando existan copias de respaldo pendientes de eliminacion rutinaria.',
];

const deletionProcedures = [
	'Eliminacion: los datos personales se eliminan de nuestros sistemas y dejan de tratarse activamente.',
	'Backups: copias residuales pueden permanecer cifradas por un periodo limitado acorde con nuestra politica de respaldos.',
	'Anonimizacion: en algunos casos convertimos datos personales en datos estadisticos anonimos no vinculables contigo.',
];

const legalDisclosureReasons = [
	'Cumplir una obligacion legal.',
	'Proteger y defender los derechos o bienes de la Empresa.',
	'Prevenir o investigar posibles irregularidades relacionadas con el Servicio.',
	'Proteger la seguridad personal de usuarios o del publico.',
	'Proteger frente a responsabilidad legal.',
];

const adsPolicy = {
	providerName: 'Google',
	dartCookieName: 'DART',
	googleAdsPolicyUrl: 'https://policies.google.com/technologies/ads',
};
---

<MainLayout
	title="Politica de Privacidad | Gasmovil"
	description="Politica de privacidad de Gasmovil para usuarios y proveedores en Mexico."
>
	<main class="px-4 py-12 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-4xl rounded-4xl border border-slate-200/80 bg-white p-8 shadow-lg shadow-slate-950/5 sm:p-10">
			<p class="section-kicker">Legal</p>
			<h1 class="section-title text-4xl">Politica de privacidad</h1>
			<p class="mt-4 text-sm text-slate-500">Ultima actualizacion: {policy.lastUpdated}</p>

			<div class="mt-8 space-y-8 text-base leading-8 text-slate-600">
				<section>
					<p>
						Esta Politica de Privacidad describe nuestras politicas y procedimientos sobre la
						recopilacion, uso y divulgacion de tu informacion cuando usas el Servicio, asi como tus
						derechos de privacidad y la forma en que la ley te protege.
					</p>
					<p class="mt-3">
						Usamos tus Datos Personales para proporcionar y mejorar el Servicio. Al utilizar el
						Servicio, aceptas la recopilacion y el uso de informacion de acuerdo con esta Politica
						de Privacidad. Esta politica ha sido creada con apoyo de un generador de politicas de
						privacidad.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">1. Interpretacion y definiciones</h2>
					<p class="mt-3">
						Las palabras con inicial en mayuscula tienen los significados definidos en esta politica.
						Las siguientes definiciones aplican por igual en singular o plural.
					</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						<li><strong>Cuenta:</strong> cuenta unica creada para acceder al Servicio o parte de el.</li>
						<li>
							<strong>Afiliada:</strong> entidad que controla, es controlada por, o esta bajo control comun
							con una parte, entendiendo por control la titularidad del 50% o mas de acciones,
							participaciones u otros valores con derecho a voto.
						</li>
						<li><strong>Aplicacion:</strong> {policy.applicationName}, el programa de software proporcionado por la Empresa.</li>
						<li>
							<strong>Empresa:</strong> {policy.companyName}, {policy.companyAddress} En esta politica tambien
							se le denomina como "la Empresa", "Nosotros" o "Nuestro".
						</li>
						<li><strong>Pais:</strong> {policy.country}.</li>
						<li><strong>Dispositivo:</strong> cualquier dispositivo que pueda acceder al Servicio, como computadora, telefono celular o tableta digital.</li>
						<li>
							<strong>Datos Personales (o Informacion Personal):</strong> cualquier informacion relacionada
							con una persona identificada o identificable. Usamos ambos terminos de forma
							intercambiable salvo que una ley use uno en especifico.
						</li>
						<li><strong>Servicio:</strong> la Aplicacion.</li>
						<li>
							<strong>Proveedor de Servicios:</strong> persona fisica o moral que procesa datos por cuenta de la
							Empresa para facilitar, prestar o analizar el uso del Servicio.
						</li>
						<li><strong>Datos de Uso:</strong> datos recopilados automaticamente por el uso del Servicio o su infraestructura.</li>
						<li><strong>Tu:</strong> la persona que accede o usa el Servicio, o la entidad legal en cuyo nombre actua.</li>
					</ul>
				</section>

				<AdBanner
					adSlot={adSlotIDTop}
					maxWidth="728px"
					mobileMinHeight={90}
					tabletMinHeight={120}
					desktopMinHeight={180}
				/>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">2. Recopilacion y uso de tus Datos Personales</h2>
					<h3 class="mt-3 text-xl font-semibold text-slate-900">Tipos de datos recopilados</h3>
					<h4 class="mt-3 text-lg font-semibold text-slate-900">Datos Personales</h4>
					<p class="mt-3">
						Al usar nuestro Servicio, podemos pedirte informacion personal identificable que puede
						utilizarse para contactarte o identificarte, incluyendo pero no limitandose a:
					</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{personalDataItems.map((item) => <li>{item}</li>)}
					</ul>
					<h4 class="mt-4 text-lg font-semibold text-slate-900">Datos de Uso</h4>
					<p class="mt-3">
						Los Datos de Uso se recopilan automaticamente al utilizar el Servicio. Pueden incluir,
						entre otros, los siguientes datos:
					</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{usageDataItems.map((item) => <li>{item}</li>)}
					</ul>
					<p class="mt-3">
						Tambien podemos recopilar informacion que tu navegador envia cada vez que visitas el
						Servicio o cuando accedes por medio de un dispositivo movil.
					</p>
					<h4 class="mt-4 text-lg font-semibold text-slate-900">Informacion recopilada al usar la Aplicacion</h4>
					<p class="mt-3">
						Para habilitar funciones de la Aplicacion, podemos recopilar con tu autorizacion previa:
					</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{appDataItems.map((item) => <li>{item}</li>)}
					</ul>
					<p class="mt-3">
						Usamos esta informacion para ofrecer funciones del Servicio, asi como para mejorar y
						personalizar la experiencia. La informacion puede cargarse a servidores de la Empresa o
						de Proveedores de Servicios, o bien almacenarse localmente en tu dispositivo.
					</p>
					<p class="mt-3">
						Puedes habilitar o deshabilitar el acceso a esta informacion en cualquier momento desde
						la configuracion de tu dispositivo.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">3. Uso de tus Datos Personales</h2>
					<p class="mt-3">La Empresa puede usar Datos Personales para los siguientes fines:</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{personalDataUses.map((item) => <li>{item}</li>)}
					</ul>
					<p class="mt-3">Podemos compartir tus Datos Personales en estas situaciones:</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{personalDataSharing.map((item) => <li>{item}</li>)}
					</ul>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">4. Conservacion de tus Datos Personales</h2>
					<p class="mt-3">
						La Empresa conservara tus Datos Personales solo durante el tiempo necesario para los fines
						descritos en esta Politica de Privacidad y para cumplir obligaciones legales, resolver
						controversias y ejecutar acuerdos.
					</p>
					<p class="mt-3">
						Cuando sea posible, aplicamos periodos de conservacion mas cortos y/o reducimos la
						identificabilidad eliminando, agregando o anonimizando datos. Salvo indicacion distinta,
						los periodos indicados son maximos ("hasta").
					</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{retentionItems.map((item) => <li>{item}</li>)}
					</ul>
					<p class="mt-3">
						Los Datos de Uso se conservan conforme a esos periodos y solo por mas tiempo cuando sea
						necesario para seguridad, prevencion de fraude o cumplimiento legal.
					</p>
					<p class="mt-3">Podemos conservar datos por mas tiempo por los siguientes motivos:</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{retentionExtensionReasons.map((item) => <li>{item}</li>)}
					</ul>
					<p class="mt-3">
						Puedes solicitar informacion sobre los periodos de conservacion aplicables contactandonos.
					</p>
					<p class="mt-3">Al expirar los periodos de conservacion, eliminamos o anonimizamos datos mediante:</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{deletionProcedures.map((item) => <li>{item}</li>)}
					</ul>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">5. Transferencia de tus Datos Personales</h2>
					<p class="mt-3">
						Tu informacion, incluidos Datos Personales, se procesa en oficinas operativas de la
						Empresa y en otros lugares donde se encuentran las partes que intervienen en el
						tratamiento. Esto puede implicar transferencias y almacenamiento en computadoras ubicadas
						fuera de tu estado, provincia, pais u otra jurisdiccion con leyes de proteccion de datos
						diferentes.
					</p>
					<p class="mt-3">
						Cuando la ley aplicable lo requiera, adoptaremos salvaguardas adecuadas y medidas
						complementarias para transferencias internacionales. La Empresa tomara medidas razonables
						para asegurar un tratamiento seguro y conforme a esta politica.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">6. Eliminacion de tus Datos Personales</h2>
					<p class="mt-3">
						Tienes derecho a eliminar o solicitar nuestra ayuda para eliminar los Datos Personales que
						hemos recopilado sobre ti.
					</p>
					<p class="mt-3">
						El Servicio puede ofrecerte mecanismos para borrar cierta informacion desde la propia
						aplicacion. Tambien puedes actualizar, modificar o eliminar informacion iniciando sesion en
						tu Cuenta y revisando la seccion correspondiente.
					</p>
					<p class="mt-3">
						Si lo prefieres, puedes contactarnos para solicitar acceso, correccion o eliminacion de
						tus Datos Personales. Ten en cuenta que podriamos conservar cierta informacion cuando
						exista una obligacion legal o base juridica para hacerlo.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">7. Divulgacion de tus Datos Personales</h2>
					<h3 class="mt-3 text-xl font-semibold text-slate-900">Transacciones comerciales</h3>
					<p class="mt-3">
						Si la Empresa participa en una fusion, adquisicion o venta de activos, tus Datos
						Personales podrian transferirse. Te notificaremos antes de que tus datos queden sujetos a
						una politica de privacidad diferente.
					</p>
					<h3 class="mt-4 text-xl font-semibold text-slate-900">Cumplimiento con autoridades</h3>
					<p class="mt-3">
						En determinadas circunstancias, la Empresa puede verse obligada a divulgar tus Datos
						Personales por requerimiento legal o por solicitudes validas de autoridades publicas
						(por ejemplo, un tribunal o una agencia gubernamental).
					</p>
					<h3 class="mt-4 text-xl font-semibold text-slate-900">Otros requisitos legales</h3>
					<p class="mt-3">
						La Empresa puede divulgar tus Datos Personales cuando crea de buena fe que es necesario
						para:
					</p>
					<ul class="mt-3 list-disc space-y-2 pl-6">
						{legalDisclosureReasons.map((item) => <li>{item}</li>)}
					</ul>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">8. Seguridad de tus Datos Personales</h2>
					<p class="mt-3">
						La seguridad de tus Datos Personales es importante para nosotros, pero ningun metodo de
						transmision por Internet o almacenamiento electronico es 100% seguro. Aunque aplicamos
						medidas comercialmente razonables para proteger tus datos, no podemos garantizar su
						seguridad absoluta.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">9. Privacidad de menores</h2>
					<p class="mt-3">
						Nuestro Servicio no esta dirigido a personas menores de {policy.minorAge} anos. No
						recopilamos de forma consciente informacion personal identificable de menores de esa edad.
						Si eres madre, padre o tutor y detectas que un menor a tu cargo nos proporciono Datos
						Personales, contactanos para atender el caso.
					</p>
					<p class="mt-3">
						Si detectamos recopilacion de datos de menores de {policy.minorAge} anos sin verificacion
						de consentimiento parental, tomaremos medidas para eliminar esa informacion de nuestros
						servidores. Si la base legal de tratamiento es el consentimiento y la normativa local exige
						consentimiento de madre, padre o tutor, podremos solicitarlo antes de recopilar y usar esa
						informacion.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">10. Enlaces a otros sitios web</h2>
					<p class="mt-3">
						El Servicio puede contener enlaces a sitios web de terceros no operados por nosotros. Si
						haces clic en un enlace de terceros, seras redirigido al sitio de dicho tercero.
						Recomendamos revisar la politica de privacidad de cada sitio que visites.
					</p>
					<p class="mt-3">
						No tenemos control ni asumimos responsabilidad por contenido, politicas de privacidad o
						practicas de sitios o servicios de terceros.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">11. Publicidad de terceros y cookies</h2>
					<p class="mt-3">
						Podemos usar proveedores externos para mostrar anuncios en el Servicio. Actualmente,
						utilizamos servicios de publicidad de {adsPolicy.providerName}.
					</p>
					<p class="mt-3">
						{adsPolicy.providerName}, como proveedor externo, puede utilizar cookies para mostrar
						anuncios en funcion de tus visitas previas a este y otros sitios web. Entre ellas puede
						encontrarse la cookie {adsPolicy.dartCookieName}, que permite servir anuncios mas
						relevantes para los usuarios.
					</p>
					<p class="mt-3">
						Puedes inhabilitar el uso de la cookie {adsPolicy.dartCookieName} y revisar mas
						informacion sobre publicidad personalizada en la politica de anuncios de
						{adsPolicy.providerName}: <a class="font-semibold text-slate-900 underline decoration-slate-300 underline-offset-4 hover:text-slate-700" href={adsPolicy.googleAdsPolicyUrl} target="_blank" rel="noopener noreferrer">{adsPolicy.googleAdsPolicyUrl}</a>.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">12. Cambios a esta Politica de Privacidad</h2>
					<p class="mt-3">
						Podemos actualizar nuestra Politica de Privacidad periodicamente. Notificaremos cualquier
						cambio publicando la nueva version en esta pagina.
					</p>
					<p class="mt-3">
						Tambien podremos avisarte por correo electronico y/o mediante un aviso visible en el
						Servicio antes de que entre en vigor el cambio, ademas de actualizar la fecha de
						"Ultima actualizacion" al inicio de esta politica.
					</p>
					<p class="mt-3">
						Te recomendamos revisar esta politica periodicamente. Los cambios entran en vigor cuando
						se publican en esta pagina.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-slate-950">13. Contacto</h2>
					<p class="mt-3">Si tienes dudas sobre esta Politica de Privacidad, puedes contactarnos en:</p>
					<p class="mt-3 font-semibold text-slate-900">Correo: {policy.contactEmail}</p>
				</section>
			</div>

			<div class="mt-10 flex flex-wrap gap-3">
				<a href="/" class="inline-flex h-11 items-center justify-center rounded-full border border-slate-300 px-5 text-sm font-semibold text-slate-900 transition hover:bg-slate-50">Volver al inicio</a>
				<a href={`mailto:${policy.contactEmail}`} class="inline-flex h-11 items-center justify-center rounded-full bg-(--client-500) px-5 text-sm font-semibold text-white transition hover:bg-(--client-600)">Contactar por privacidad</a>
			</div>
		</div>
	</main>
</MainLayout>
