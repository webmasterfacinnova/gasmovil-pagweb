---
interface Props {
  adClient?: string;
  adSlot: string;
  adFormat?: "auto" | "fluid" | "rectangle" | "horizontal" | "vertical";
  fullWidthResponsive?: boolean;
  maxWidth?: string;
  mobileMinHeight?: number;
  tabletMinHeight?: number;
  desktopMinHeight?: number;
}

const {
  adClient = "ca-pub-6999979117716027",
  adSlot,
  adFormat = "auto",
  fullWidthResponsive = true,
  maxWidth = "1100px",
  mobileMinHeight = 120,
  tabletMinHeight = 180,
  desktopMinHeight = 250,
} = Astro.props as Props;
---
<div
  class="ad-banner my-8"
  style={`--ad-mobile-min-h:${mobileMinHeight}px;--ad-tablet-min-h:${tabletMinHeight}px;--ad-desktop-min-h:${desktopMinHeight}px;--ad-max-width:${maxWidth};`}
>
  <ins
    class="adsbygoogle ad-banner__slot"
    style="display:block"
    data-ad-client={adClient}
    data-ad-slot={adSlot}
    data-ad-format={adFormat}
    data-full-width-responsive={fullWidthResponsive ? "true" : "false"}
  ></ins>

  <script is:inline>
    (() => {
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch {
        // The script may not be ready yet in local/dev; keep reserved space anyway.
      }
    })();
  </script>
</div>

<style>
  .ad-banner {
    width: 100%;
    max-width: var(--ad-max-width);
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
  }

  .ad-banner__slot {
    width: 100%;
    min-height: var(--ad-mobile-min-h);
  }

  @media (min-width: 640px) {
    .ad-banner__slot {
      min-height: var(--ad-tablet-min-h);
    }
  }

  @media (min-width: 1024px) {
    .ad-banner__slot {
      min-height: var(--ad-desktop-min-h);
    }
  }
</style>