---
import { BadgeDollarSign, Flame, MapPinned, Navigation, Route, Truck } from 'lucide-react';

interface Props {
	variant: 'customer' | 'tracking' | 'supplier';
	title: string;
	subtitle: string;
	badge: string;
}

const { variant, title, subtitle, badge } = Astro.props;

const styles = {
	customer: {
		shell: 'border-[var(--client-200)] bg-gradient-to-b from-white to-[var(--client-50)]',
		badge: 'bg-[var(--client-500)] text-white',
		accent: 'text-[var(--client-600)]',
		soft: 'bg-[var(--client-50)]',
		line: '#ff6262',
		icon: Flame,
	},
	tracking: {
		shell: 'border-slate-200 bg-gradient-to-b from-white to-slate-50',
		badge: 'bg-slate-900 text-white',
		accent: 'text-slate-700',
		soft: 'bg-slate-100',
		line: '#0f172a',
		icon: Route,
	},
	supplier: {
		shell: 'border-[var(--supply-200)] bg-gradient-to-b from-white to-[var(--supply-50)]',
		badge: 'bg-[var(--supply-500)] text-[var(--supply-950)]',
		accent: 'text-[var(--supply-700)]',
		soft: 'bg-[var(--supply-50)]',
		line: '#c49c2e',
		icon: Truck,
	},
}[variant];

const Icon = styles.icon;
---

<div class={`mx-auto w-full max-w-sm rounded-[2.4rem] border p-3 shadow-2xl shadow-slate-950/10 ${styles.shell}`}>
	<div class="rounded-[1.9rem] border border-black/5 bg-white p-4 shadow-inner shadow-slate-950/5">
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-3">
				<div class={`rounded-2xl p-2 ${styles.soft} ${styles.accent}`}>
					<Icon className="h-5 w-5" />
				</div>
				<div>
					<p class="text-sm font-semibold text-slate-900">{title}</p>
					<p class="text-xs text-slate-500">{subtitle}</p>
				</div>
			</div>
			<span class={`rounded-full px-3 py-1 text-[11px] font-semibold ${styles.badge}`}>{badge}</span>
		</div>

		<div class="mt-4 overflow-hidden rounded-[1.6rem] border border-slate-200 bg-slate-50 p-3">
			<div class="h-44 rounded-[1.2rem] bg-[linear-gradient(135deg,#eef2ff_0%,#f8fafc_40%,#fefce8_100%)] p-3">
				<div class="relative h-full rounded-[1rem] border border-white/40 bg-white/50">
					<div class="absolute left-4 top-5 flex items-center gap-2 rounded-full bg-white/80 px-3 py-1 text-[11px] font-medium text-slate-500 shadow-sm">
						<MapPinned className="h-3.5 w-3.5" />
						CDMX
					</div>
					<svg viewBox="0 0 260 150" class="absolute inset-0 h-full w-full">
						<path
							d="M28 110 C55 74, 87 90, 112 58 S164 31, 195 73 S226 118, 235 46"
							fill="none"
							stroke={styles.line}
							stroke-linecap="round"
							stroke-width="6"
							stroke-dasharray={variant === 'tracking' ? '12 10' : undefined}
						/>
						<circle cx="28" cy="110" r="8" fill="#ffffff" stroke={styles.line} stroke-width="5"></circle>
						<circle cx="112" cy="58" r="8" fill="#ffffff" stroke={styles.line} stroke-width="5"></circle>
						<circle cx="235" cy="46" r="8" fill="#ffffff" stroke={styles.line} stroke-width="5"></circle>
					</svg>
					<div class={`absolute right-4 bottom-4 rounded-2xl px-3 py-2 text-xs font-semibold shadow-lg ${styles.badge}`}>
						{variant === 'supplier' ? 'Navegación activa' : 'Ruta confirmada'}
					</div>
				</div>
			</div>

			<div class="mt-3 grid gap-3">
				<div class={`flex items-center justify-between rounded-2xl px-3 py-2.5 ${styles.soft}`}>
					<div class="flex items-center gap-2 text-sm text-slate-600">
						{variant === 'supplier' ? <BadgeDollarSign className="h-4 w-4" /> : <Navigation className="h-4 w-4" />}
						<span>{variant === 'supplier' ? 'Precio configurado' : 'Camión en camino'}</span>
					</div>
					<strong class="text-sm text-slate-900">
						{variant === 'supplier' ? '$12.90/L' : '12 min'}
					</strong>
				</div>
				<div class="flex items-center justify-between rounded-2xl bg-white px-3 py-2.5 shadow-sm shadow-slate-950/5">
					<span class="text-sm text-slate-500">Estado</span>
					<strong class={`text-sm ${styles.accent}`}>
						{variant === 'customer'
							? 'Pedido confirmado'
							: variant === 'tracking'
								? 'Seguimiento visible'
								: 'Orden aceptada'}
					</strong>
				</div>
			</div>
		</div>
	</div>
</div>