---
import { Download, Flame, Menu, ShieldCheck } from 'lucide-react';
import { playStoreUrl } from '../lib/appConfig';



---

<header class="sticky top-0 z-50 px-4 pt-4 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl rounded-full border border-white/15 bg-white/75 px-5 py-3 shadow-lg shadow-slate-950/5 backdrop-blur">
		<div class="flex items-center gap-4">
			<a href="#top" class="flex items-center gap-3">
				<img src="/assets/img/icon.png" alt="Logo Gasmovil" class="h-11 w-11 rounded-2xl object-cover" />
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-400">Gasmovil</p>
					<p class="text-sm text-slate-600">Cliente y proveedor en la misma ruta</p>
				</div>
			</a>

			<nav class="ml-auto hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
				<a class="transition hover:text-slate-950" href="#features">Features</a>
				<a class="transition hover:text-slate-950" href="#eliminar-datos">Eliminar datos</a>
				<a class="transition hover:text-slate-950" href="#contacto">Contacto</a>
			</nav>

			<div class="ml-auto hidden md:block">
				<a
					href={playStoreUrl}
					target="_blank"
					rel="noreferrer"
					class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-slate-950 px-5 text-sm font-semibold text-white transition hover:bg-slate-800"
				>
					<Download className="h-4 w-4" />
					Google Play
				</a>
			</div>

			<details class="ml-auto md:hidden">
				<summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-slate-200 bg-white text-slate-800">
					<Menu className="h-5 w-5" />
				</summary>
				<div class="absolute inset-x-4 top-[calc(100%+0.75rem)] rounded-3xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-950/10">
					<nav class="flex flex-col gap-4 text-sm font-medium text-slate-700">
						<a href="#features">Features</a>
						<a href="#eliminar-datos">Eliminar datos</a>
						<a href="#contacto">Contacto</a>
						<a
							href={playStoreUrl}
							target="_blank"
							rel="noreferrer"
							class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-slate-950 px-5 text-sm font-semibold text-white"
						>
							<Download className="h-4 w-4" />
							Descargar app
						</a>
					</nav>
					<div class="mt-4 flex items-center gap-3 rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
						<ShieldCheck className="h-4 w-4 text-[var(--client-500)]" />
						Sitio orientado a cumplimiento y conversión.
					</div>
				</div>
			</details>
		</div>
	</div>
</header>