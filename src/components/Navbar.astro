---
import { Download, Menu, ShieldCheck } from 'lucide-react';
import { playStoreUrl } from '../lib/appConfig';

---

<header class="sticky top-0 z-50 px-4 pt-4 sm:px-6 lg:px-8">
	<div class="glass-panel mx-auto max-w-7xl rounded-full px-5 py-3">
		<div class="flex items-center gap-4">
			<a href="#top" class="flex items-center gap-3">
				<img src="/assets/img/icon.png" alt="Logo Gasmovil" class="h-11 w-11 rounded-2xl object-cover" />
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-[var(--client-400)]">Gasmovil</p>
					<p class="text-sm text-slate-400">Cliente y proveedor en la misma ruta</p>
				</div>
			</a>

			<nav class="ml-auto hidden items-center gap-7 text-sm font-medium text-slate-300 md:flex">
				<a class="transition hover:text-white" href="#top">Inicio</a>
				<a class="transition hover:text-white" href="#features">Soy cliente</a>
				<a class="transition hover:text-white" href="#mockups">Soy proveedor</a>
				<a class="transition hover:text-white" href="#contacto">Contacto</a>
			</nav>

			<div class="ml-auto hidden md:block">
				<a
					href={playStoreUrl}
					target="_blank"
					rel="noreferrer"
					class="inline-flex h-11 items-center justify-center transition hover:opacity-80"
				>
					<img src="/assets/img/google-play.png" alt="Google Play" class="h-12 w-auto object-contain" />
				</a>
			</div>

			<details class="ml-auto md:hidden" aria-haspopup="true">
				<summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/20 bg-white/10 text-white" aria-label="Abrir menú">
					<Menu className="h-5 w-5" />
				</summary>
				<div class="glass-panel absolute inset-x-4 top-[calc(100%+0.75rem)] rounded-3xl border border-white/20 p-5">
					<nav class="flex flex-col gap-4 text-sm font-medium text-slate-200">
						<a href="#top" class="transition hover:text-white">Inicio</a>
						<a href="#features" class="transition hover:text-white">Soy cliente</a>
						<a href="#mockups" class="transition hover:text-white">Soy proveedor</a>
						<a href="#contacto" class="transition hover:text-white">Contacto</a>
						<a
							href={playStoreUrl}
							target="_blank"
							rel="noreferrer"
							class="inline-flex h-11 items-center justify-center transition hover:opacity-80"
						>
							<img src="/assets/img/google-play.png" alt="Google Play" class="h-12 w-auto object-contain" />
						</a>
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>
