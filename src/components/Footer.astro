---
import {
	siFacebook,
	siGmail,
	siGoogleplay,
	siInstagram,
	
} from 'simple-icons';
import { APP_NAME, CONTACT_MAILTO, playStoreUrl } from '../lib/appConfig';

let currentYear = new Date().getFullYear();

const socialLinks = [
	{ href: playStoreUrl, label: 'Google Play', icon: siGoogleplay },
	{ href: 'https://www.facebook.com', label: 'Facebook', icon: siFacebook },
	{ href: 'https://www.instagram.com', label: 'Instagram', icon: siInstagram },
	
	{ href: CONTACT_MAILTO, label: 'Correo de contacto', icon: siGmail },
];
---

<footer class="px-4 pb-10 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl rounded-4xl border border-slate-200/80 bg-white px-6 py-8 shadow-lg shadow-slate-950/5 sm:px-8">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
			<div class="flex items-center gap-4">
				<img src="/assets/img/icon.png" alt={`Logo ${APP_NAME}`} class="h-12 w-12 rounded-2xl object-cover" />
				<div>
					<p class="text-base font-semibold text-slate-950">{APP_NAME}</p>
					<p class="text-sm text-slate-500">Gas a domicilio con mejor visibilidad para México.</p>
				</div>
			</div>

			<div class="flex flex-wrap items-center gap-3 text-sm font-medium text-slate-600">
				<a href="/legal/privacy" class="transition hover:text-slate-950">Política de privacidad</a>
				<a href="/legal/terms" class="transition hover:text-slate-950">Términos de uso</a>
				<a href="#contacto" class="transition hover:text-slate-950">Contacto</a>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				{socialLinks.map((item) => (
					<a
						href={item.href}
						target={item.href.startsWith('http') ? '_blank' : undefined}
						rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
						class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-700 transition hover:bg-slate-50"
						aria-label={item.label}
					>
						<svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" fill="currentColor">
							<path d={item.icon.path} />
						</svg>
					</a>
				))}
			</div>
		</div>

		<div class="mt-6 border-t border-slate-200 pt-6 text-sm text-slate-500">
				<p class="text-center">© {currentYear} {APP_NAME}. Todos los derechos reservados.</p>
			
		</div>
	</div>
</footer>