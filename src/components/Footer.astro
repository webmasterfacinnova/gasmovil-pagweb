---
import {
	siFacebook,
	siGmail,
	siGoogleplay,
	siInstagram,
	
} from 'simple-icons';
import { APP_NAME, CONTACT_MAILTO, playStoreUrl } from '../lib/appConfig';

let currentYear = new Date().getFullYear();

const socialLinks = [
	{ href: playStoreUrl, label: 'Google Play', icon: siGoogleplay },
	{ href: 'https://www.facebook.com', label: 'Facebook', icon: siFacebook },
	{ href: 'https://www.instagram.com', label: 'Instagram', icon: siInstagram },
	
	{ href: CONTACT_MAILTO, label: 'Correo de contacto', icon: siGmail },
];
---

<footer class="px-4 pb-10 sm:px-6 lg:px-8">
	<div class="glass-panel mx-auto max-w-7xl rounded-3xl border border-white/10 px-6 py-8 sm:px-8">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
			<div class="flex flex-col gap-4">
				<div class="flex items-center gap-4">
					<img src="/assets/img/zerkio-logo.png" alt={`Logo ${APP_NAME}`} class="h-12 w-12 rounded-xl object-contain" />
					<div>
						<p class="text-base font-semibold text-white">{APP_NAME}</p>
						<p class="text-sm text-slate-400">Gas a domicilio con mejor visibilidad para México.</p>
					</div>
				</div>
				<div>
					<p class="text-sm text-slate-400">
						Mockups de dispositivos provistos por <a href="https://mockuphone.com/" target="_blank" class="text-md font-extrabold text-(--client-800)" >MockUPhone</a>.
					</p>
				</div>
			</div>

			<div class="flex flex-wrap items-center gap-3 text-sm font-medium text-slate-300">
				<a href="/legal/privacy" class="transition hover:text-white">Política de privacidad</a>
				<a href="/legal/terms" class="transition hover:text-white">Términos de uso</a>
				<a href="#contacto" class="transition hover:text-white">Contacto</a>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				{socialLinks.map((item) => (
					<a
						href={item.href}
						target={item.href.startsWith('http') ? '_blank' : undefined}
						rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
						class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-slate-300 transition hover:bg-white/10 hover:text-white"
						aria-label={item.label}
					>
						<svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" fill="currentColor">
							<path d={item.icon.path} />
						</svg>
					</a>
				))}
			</div>
		</div>

		<div class="mt-6 border-t border-white/10 pt-6 text-sm text-slate-400">
				<p class="text-center">© {currentYear} {APP_NAME}. Todos los derechos reservados.</p>
			
		</div>
	</div>
</footer>
